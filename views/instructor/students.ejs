<%- include('../partials/header') %>

<div class="page-head">
  <div>
    <h1>My Students</h1>
    <p>
      Total: <strong><%= totalStudents %></strong>
      <% if (sectionCodes.length) { %>
        · Sections: <strong><%= sectionCodes.map(c => c.program + '-' + c.section).join(', ') %></strong>
      <% } %>
    </p>
  </div>
  <a class="btn secondary" href="/instructor">← Dashboard</a>
</div>

<% if (!Object.keys(grouped).length) { %>
  <div class="card text-center">
    <p class="muted">No students found for your sections.</p>
  </div>
<% } else { %>
  <% Object.entries(grouped).forEach(([groupName, students]) => { %>
    <div class="card">
      <h3 class="mt-0">
        <%= groupName %>
        <span class="muted" style="font-size:14px;font-weight:400"> — <%= students.length %> student<%= students.length === 1 ? '' : 's' %></span>
      </h3>
      <div class="scroll-x">
        <table>
          <thead>
            <tr><th>Name</th><th>Email</th><th>Year Level</th><th></th></tr>
          </thead>
          <tbody>
            <% students.forEach(s => { %>
              <tr>
                <td>
                  <a class="att-person" href="/instructor/students/<%= s.id %>" style="color:inherit;text-decoration:none">
                    <%- include('../partials/avatar', { avatarPath: s.avatar_path, name: s.name, size: 'sm' }) %>
                    <strong><%= s.name %></strong>
                  </a>
                </td>
                <td><%= s.email %></td>
                <td><%= s.year_level || '—' %></td>
                <td><a class="btn small secondary" href="/instructor/students/<%= s.id %>">View profile</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% }); %>
<% } %>

<%- include('../partials/footer') %>